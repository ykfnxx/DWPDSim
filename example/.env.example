# Input and output paths are relative to the DWPDSim repository root.
DWPDSIM_REQUESTS_PATH=example/requests.jsonl
DWPDSIM_OUTPUT_DIR=build/example-pipeline
DWPDSIM_MQSIM_BINARY=../MQSim/MQSim
DWPDSIM_SSD_CONFIG=example/mqsim/ssdconfig.xml
DWPDSIM_EVENT_LIMIT=

# Simulation topology.
DWPDSIM_BLOCK_SIZE_BYTES=4096
DWPDSIM_MEMORY_CAPACITY_BYTES=8192
DWPDSIM_SLC_CAPACITY_BYTES=1048576
DWPDSIM_SLC_STREAM_COUNT=2
DWPDSIM_TLC_CAPACITY_BYTES=1048576
DWPDSIM_TLC_STREAM_COUNT=2
DWPDSIM_SIMULATION_END_NS=
DWPDSIM_PROGRESS_INTERVAL_REQUESTS=0

# Memory policy: baseline_lru (default), indexed_lru, or context_lru.
DWPDSIM_MEMORY_POLICY=baseline_lru
# context_lru: cold candidate fraction of Memory capacity, in (0, 1].
DWPDSIM_MEMORY_ALPHA=0.01
# context_lru: maximum Memory blocks evicted per decision; empty means whole current segment.
DWPDSIM_MEMORY_MAX_EVICTION_BLOCKS=
# context_lru: retention = base + this coefficient * last completed session growth (blocks).
DWPDSIM_MEMORY_RETENTION_GROWTH_SECONDS_PER_BLOCK=0
# context_lru: empty disables gap scaling; enabled requires a positive MAX_EVICTION_BLOCKS.
DWPDSIM_MEMORY_EVICTION_GAP_REFERENCE_NS=
DWPDSIM_MEMORY_EVICTION_BASE_BLOCKS=64
DWPDSIM_ADMIT_STORAGE_HITS=true
# indexed_lru and context_lru. Idle retention in nanoseconds; empty/unset disables it.
# Example: 60000000000 = 60 seconds. Strictly greater => Drop; equal => Dump.
# 0 drops only after a positive idle interval. No automatic expiry before eviction.
DWPDSIM_MEMORY_RETENTION_NS=

# infinite_storage: memory experiments, unlimited TLC, metrics only, skips MQSim.
# Storage policy. Unused fields are ignored by the selected policy.
DWPDSIM_STORAGE_POLICY=baseline_fixed_lru
# RR only. All three searches preserve the original algorithm; indexed is the default.
DWPDSIM_RR_VICTIM_SEARCH=indexed
DWPDSIM_RR_SUBTREE_COUNTS=false
# Experiment/debug switches; leave false for throughput measurements.
DWPDSIM_RR_VERIFY_VICTIMS=false
DWPDSIM_RR_PROFILE=false
DWPDSIM_FIXED_TIER=tlc
DWPDSIM_FIXED_STREAM_ID=0
DWPDSIM_SLC_WRITE_RATIO=0.0
DWPDSIM_SLC_HOST_SHARE=
DWPDSIM_IDLE_MULTIPLIER=32.0
DWPDSIM_PROMOTION_SECONDS=14400.0
DWPDSIM_ADAPTATION_GAIN=2.0
DWPDSIM_DIRECT_GAIN=1.0
DWPDSIM_SLC_SOFT_UTILIZATION=0.75
DWPDSIM_OCCUPANCY_DECAY=8.0
DWPDSIM_LOGICAL_FILL_FRACTION=0.98
DWPDSIM_SLC_ERASE_BUDGET=120.0
DWPDSIM_TLC_ERASE_BUDGET=12.0
DWPDSIM_BACKGROUND_PERIOD_NS=900000000000

# wear_balanced only: fixed WA estimates, finite and >= 1; no online feedback.
DWPDSIM_SLC_WA=1
DWPDSIM_TLC_WA=1
