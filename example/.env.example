# Input and output paths are relative to the DWPDSim repository root.
DWPDSIM_REQUESTS_PATH=example/requests.jsonl
DWPDSIM_OUTPUT_DIR=build/example-pipeline
DWPDSIM_MQSIM_BINARY=../MQSim/MQSim
DWPDSIM_SSD_CONFIG=example/mqsim/ssdconfig.xml
DWPDSIM_EVENT_LIMIT=

# Simulation topology.
DWPDSIM_BLOCK_SIZE_BYTES=4096
DWPDSIM_MEMORY_CAPACITY_BYTES=8192
DWPDSIM_SLC_CAPACITY_BYTES=1048576
DWPDSIM_SLC_STREAM_COUNT=2
DWPDSIM_TLC_CAPACITY_BYTES=1048576
DWPDSIM_TLC_STREAM_COUNT=2
DWPDSIM_SIMULATION_END_NS=
DWPDSIM_PROGRESS_INTERVAL_REQUESTS=0

# Memory policy: baseline_lru (default), indexed_lru, context_lru, or reuse_lru.
DWPDSIM_MEMORY_POLICY=baseline_lru
# reuse_lru: JSON with reuse_edges_s and nine reuse_survival rows, fitted on past data.
DWPDSIM_MEMORY_REUSE_MODEL_PATH=
# Empty probability fields disable conditional Dump / selective admission respectively.
DWPDSIM_MEMORY_REUSE_DUMP_PROBABILITY=
DWPDSIM_MEMORY_REUSE_PRIORITY=false
# Prefix model is optional in JSON; requires PRIORITY=true. Cost uses proxy units, not latency.
DWPDSIM_MEMORY_REUSE_COST_WEIGHTED=false
DWPDSIM_MEMORY_REUSE_RECOMPUTE_WEIGHT=1
DWPDSIM_MEMORY_REUSE_ADMIT_PROBABILITY=
DWPDSIM_MEMORY_REUSE_SHORT_HORIZON_S=60
DWPDSIM_MEMORY_REUSE_LONG_HORIZON_S=3600
# context_lru / reuse_lru: cold candidate fraction of Memory capacity, in (0, 1].
DWPDSIM_MEMORY_ALPHA=0.01
# context_lru / reuse_lru: maximum Memory blocks evicted per decision; empty means whole current segment.
DWPDSIM_MEMORY_MAX_EVICTION_BLOCKS=
# context_lru: retention = base + this coefficient * last completed session growth (blocks).
DWPDSIM_MEMORY_RETENTION_GROWTH_SECONDS_PER_BLOCK=0
# context_lru: empty disables gap scaling; enabled requires a positive MAX_EVICTION_BLOCKS.
DWPDSIM_MEMORY_EVICTION_GAP_REFERENCE_NS=
DWPDSIM_MEMORY_EVICTION_BASE_BLOCKS=64
DWPDSIM_ADMIT_STORAGE_HITS=true
# indexed_lru and context_lru. Idle retention in nanoseconds; empty/unset disables it.
# Example: 60000000000 = 60 seconds. Strictly greater => Drop; equal => Dump.
# 0 drops only after a positive idle interval. No automatic expiry before eviction.
DWPDSIM_MEMORY_RETENTION_NS=

# infinite_storage: memory experiments, unlimited TLC, metrics only, skips MQSim.
# Storage policy. Unused fields are ignored by the selected policy.
DWPDSIM_STORAGE_POLICY=baseline_fixed_lru
# RR only. All three searches preserve the original algorithm; indexed is the default.
DWPDSIM_RR_VICTIM_SEARCH=indexed
DWPDSIM_RR_SUBTREE_COUNTS=false
# Experiment/debug switches; leave false for throughput measurements.
DWPDSIM_RR_VERIFY_VICTIMS=false
DWPDSIM_RR_PROFILE=false
DWPDSIM_FIXED_TIER=tlc
DWPDSIM_FIXED_STREAM_ID=0
DWPDSIM_SLC_WRITE_RATIO=0.0
DWPDSIM_SLC_HOST_SHARE=
DWPDSIM_IDLE_MULTIPLIER=32.0
DWPDSIM_PROMOTION_SECONDS=14400.0
DWPDSIM_ADAPTATION_GAIN=2.0
DWPDSIM_DIRECT_GAIN=1.0
DWPDSIM_SLC_SOFT_UTILIZATION=0.75
DWPDSIM_OCCUPANCY_DECAY=8.0
DWPDSIM_LOGICAL_FILL_FRACTION=0.98
DWPDSIM_SLC_ERASE_BUDGET=120.0
DWPDSIM_TLC_ERASE_BUDGET=12.0
DWPDSIM_BACKGROUND_PERIOD_NS=900000000000

# wear_balanced always uses Shadow FTL; enable online tuning for adaptive idle.
# Reuse thresholds count KV blocks. Nominal capacity 0 uses the storage tier capacity.
DWPDSIM_ONLINE_TUNING=false
DWPDSIM_FEEDBACK_PERIOD_NS=900000000000
DWPDSIM_SHADOW_PAGE_BYTES=4096
DWPDSIM_SHADOW_PAGES_PER_BLOCK=256
DWPDSIM_SHADOW_OVERPROVISIONING=0.07
DWPDSIM_SHADOW_SLC_NOMINAL_BYTES=0
DWPDSIM_SHADOW_TLC_NOMINAL_BYTES=0
DWPDSIM_REUSE_LOSS_BUDGET=0.01
DWPDSIM_MIN_REUSE_BLOCKS=4096
DWPDSIM_REUSE_EMA_SCALE_BLOCKS=50000
# Optional exact physical geometry; 0 derives it from nominal bytes and OP.
DWPDSIM_SHADOW_SLC_PHYSICAL_BLOCKS=0
DWPDSIM_SHADOW_TLC_PHYSICAL_BLOCKS=0

# Opt-in hybrid backend replay. Disabled preserves the complete legacy pipeline.
# When enabled: MEMORY_POLICY=baseline_lru; STORAGE_POLICY=infinite_storage,
# wear_share_round_robin or adaptive_endurance. Finite replay requires IO trace.
# REQUESTS_PATH contains HybridEvent JSONL, not the legacy Request format.
# MEMORY_CAPACITY_BYTES is the shared total; component capacity fields stay zero.
DWPDSIM_HYBRID_ENABLED=false
DWPDSIM_HYBRID_FULL_CAPACITY_BYTES=0
DWPDSIM_HYBRID_LINEAR_CAPACITY_BYTES=0
DWPDSIM_HYBRID_FULL_BLOCK_BYTES=0
DWPDSIM_HYBRID_LINEAR_CHECKPOINT_BYTES=0
DWPDSIM_HYBRID_FULL_POLICY=segment_lru
DWPDSIM_HYBRID_LINEAR_POLICY=checkpoint_lru
# For shared LRU-K set both policies to lru_k. K counts distinct consuming requests.
DWPDSIM_HYBRID_LRU_K=2
DWPDSIM_HYBRID_ALPHA=0.1
DWPDSIM_HYBRID_DECAY_SECONDS=60
DWPDSIM_HYBRID_LINEAR_READ_COST=1
DWPDSIM_HYBRID_ADMIT_STORAGE_HITS=true
DWPDSIM_HYBRID_DUMP_ON_EVICTION=true
# prefix_replay consumes HybridPrefillRequest JSONL and generates checkpoints.
# Set TOKENS_PER_BLOCK to the input hash block size; interval must be divisible by it.
DWPDSIM_HYBRID_REPLAY_MODE=exact_objects
DWPDSIM_HYBRID_TOKENS_PER_BLOCK=0
DWPDSIM_HYBRID_CHECKPOINT_INTERVAL_TOKENS=4096
# request_end publishes one state at the final complete block; interval applies to chunked_prefill.
DWPDSIM_HYBRID_CHECKPOINT_GENERATION=chunked_prefill
# Optional quotas apply only to evictions without an existing SSD copy.
# Empty preserves DUMP_ON_EVICTION. indexed_segment_lru is an equivalent indexed FULL selector.
DWPDSIM_HYBRID_FULL_DROP_FRACTION=
DWPDSIM_HYBRID_LINEAR_DROP_FRACTION=
DWPDSIM_HYBRID_EMIT_IO_TRACE=true
DWPDSIM_HYBRID_RECOMPUTE_WEIGHT=1
DWPDSIM_HYBRID_TAIL_PRIOR=1
DWPDSIM_HYBRID_DROP_PHASE=0

# shared uses only total MemoryConfig capacity and global LRU/LRU-K candidates.
# Component caps must be zero. fixed/adaptive are explicit experiment modes.
DWPDSIM_HYBRID_POOL_ALLOCATION=shared
DWPDSIM_HYBRID_POOL_DECAY_SECONDS=300
# retention selects Dump/Drop from idle age; blank retention means always Dump.
DWPDSIM_HYBRID_EVICTION_MODE=legacy
DWPDSIM_HYBRID_FULL_RETENTION_NS=
DWPDSIM_HYBRID_LINEAR_RETENTION_NS=
DWPDSIM_HYBRID_LINEAR_RETENTION_POLICY=idle
